<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/apps_title"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/modeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <RadioButton
            android:id="@+id/rbAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_all"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rbExcept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_except"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rbOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_only"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:hint="@string/apps_search"
        android:inputType="text"
        android:maxLines="1"
        android:padding="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="#99FFFFFF"
        android:textSize="15sp" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp" />
</LinearLayout>
