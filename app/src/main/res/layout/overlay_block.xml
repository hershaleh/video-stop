<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:clickable="true"
    android:focusable="true"
    android:layoutDirection="rtl">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="1dp"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="@dimen/overlay_circle"
                android:layout_height="@dimen/overlay_circle"
                android:background="@drawable/bg_circle">

                <ImageView
                    android:layout_width="@dimen/overlay_icon"
                    android:layout_height="@dimen/overlay_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_block" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/overlay_gap"
                android:gravity="center"
                android:text="@string/block_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/overlay_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/block_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/overlay_sub" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/overlay_btn_gap"
                android:background="@drawable/bg_button"
                android:stateListAnimator="@null"
                android:text="@string/block_button"
                android:textColor="@color/button_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
